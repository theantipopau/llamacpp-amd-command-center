{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llama.cpp Command Center",
  "version": "0.2.0",
  "identifier": "org.local.llamacpp.commandcenter",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "llama.cpp Command Center",
        "width": 1000,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "llama.cpp Command Center project",
    "shortDescription": "Run a local AI on your AMD Radeon GPU",
    "longDescription": "A desktop window over the llama.cpp Command Center backend: start and stop the local AI, pick a model, open the chat, and pause the model while a game uses the graphics card.",
    "copyright": "Copyright (c) the llama.cpp Command Center contributors",
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../Install-LlamaCpp-AMD.ps1": "backend/Install-LlamaCpp-AMD.ps1",
      "../../catalog": "backend/catalog"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
